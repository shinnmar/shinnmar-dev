---
import TalkCard from './TalkCard.astro';
import { talks } from '../content/talks.js';

const featured = talks.filter(t => t.featured).slice().reverse();
---

<section class="talks" id="talks">
  <div class="container">

    <div class="section-header">
      <p class="text-mono">✦ on stage</p>
      <h2>Talks <span class="text-gradient">& Charlas</span></h2>
      <p class="section-desc">
        Spaces where I share insights on frontend development, accessibility, and tech communities.
      </p>
    </div>

    <div class="talks-grid">
      {featured.map(talk => (
        <TalkCard {...talk} />
      ))}
    </div>

  </div>
</section>

<style>

.talks {
  padding: 7rem 0 1rem;
}
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .section-desc {
    font-size: var(--text-lg);
    max-width: 500px;
  }

  .talks-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  @media (max-width: 990px) {
    .talks-grid {
      grid-template-columns: 1fr;
    }
  }
</style>